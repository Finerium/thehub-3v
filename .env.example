# The Hub, application configuration (blueprint 9.15, AC-NFR-22, ADR-012).
#
# Every environment-specific value the code reads is named here with a PLACEHOLDER and no value. This file is the
# only environment file that is ever tracked; the real one is `.env.local`, which is gitignored, which no model
# thread reads, and into which the Orchestrator's generator and `vercel env pull` write. A value moves between
# files and platforms only through `thehub/tools/secret-pipe.sh` and `thehub/tools/env-share.sh`, never by hand and
# never through a chat.
#
# `tests/unit/env-example.test.ts` fails when a name the code reads is missing from this file, and
# `scripts/audits/secret-scan.sh` fails when any tracked file, this one included, carries a value with the shape of
# a credential. Copy this file to `.env.local` and fill it in there.

# --- database (Vercel-managed Neon, ADR-012) --------------------------------------------------------------------
# The pooled connection the application and the harness use. DATABASE_URL_APP is the same database as the
# restricted role `thehub_app` (D-20) and is preferred by src/db/client.ts when it is set; DATABASE_URL is the
# fallback the platform integration writes. DATABASE_URL_UNPOOLED is the owner's connection and serves migrations,
# the seed and retention only.
DATABASE_URL=postgresql://<user>:<password>@<pooled-host>/<database>?sslmode=require
DATABASE_URL_APP=postgresql://thehub_app:<password>@<pooled-host>/<database>?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://<owner>:<password>@<direct-host>/<database>?sslmode=require
# The password `pnpm db:app-role` sets on the role `thehub_app` (D-20). Rotating the role means rotating this and
# re-deriving DATABASE_URL_APP with `thehub/tools/app-role-url.sh`.
APP_ROLE_PASSWORD=<the password of the role thehub_app>
# The disposable database the `db` vitest project runs against. Unset, that project skips itself; the seeded
# database is never named here.
TEST_DATABASE_URL=postgresql://<user>:<password>@<host>/<disposable-database>?sslmode=require
# Host and port of a local Neon HTTP proxy, for the database lane on a machine with no Neon endpoint.
NEON_LOCAL_PROXY=<host:port>

# --- sessions, roles and the two machine callers -----------------------------------------------------------------
# The signing key of the session cookie. Rotating it signs everyone out, which is the intended effect.
AUTH_SECRET=<32 random bytes, base64url>
# 9.15 names it; this run does not build the signed reviewer links (D-07, ADR-013), so nothing reads it. The name
# stays here because 9.15 is frozen: not built in this run (D-07).
REVIEWER_LINK_SECRET=<not built in this run (D-07)>
# The nightly activation job, one route only: POST /api/admin/corpus/activate.
ADMIN_JOB_TOKEN=<32 random bytes, base64url>
# The golden runner's ingestion of a run, one route only: POST /api/evaluation/runs.
CI_INGEST_TOKEN=<32 random bytes, base64url>
# The read-only ed25519 deploy key CI uses to check out the private corpus repository. A key, never a personal
# token; it lives as a CI secret and never in a file on a workstation.
CORPUS_DEPLOY_KEY=<a read-only ed25519 private key, PEM>

# --- accounts ----------------------------------------------------------------------------------------------------
# The three demo accounts the Committee receives (Engineer, Reviewing Supervisor, Manager) and the Admin account,
# which is never distributed. The seed reads them; no password value is ever printed in a submitted file.
DEMO_ENGINEER_PASSWORD=<the Engineer demo password>
DEMO_SUPERVISOR_PASSWORD=<the Reviewing Supervisor demo password>
DEMO_MANAGER_PASSWORD=<the Manager demo password>
ADMIN_PASSWORD=<the Admin password>

# --- the model provider ------------------------------------------------------------------------------------------
# The one provider key, read at call time in src/gateway/provider.ts and never logged (INV-4). Nothing on the
# seeded demo path calls a provider, so the demo runs without it.
ZAI_API_KEY=<the Z.ai platform key>

# --- the harness seam and the fixtures ---------------------------------------------------------------------------
# The harness checkout beside this repository; the audits, the seed and the G1 bundle reader resolve it.
HARNESS_DIR=<path to the thehub-harness checkout>
# An explicit bundle directory for the equality tests, when it is not the one inside HARNESS_DIR.
HARNESS_BUNDLE=<path to a built bundle directory>
# The fixtures file every displayed number binds to (INV-6). Defaults to packages/fixtures.json of the bundle.
FIXTURES_PATH=<path to fixtures.json>
# The corpus checkout the M0 seed reads its documents from. The corpus is the organiser's property and lives in no
# public repository (INV-7).
CORPUS_DIR=<path to the thehub-corpus checkout>
# The JSON Schema directory `pnpm contracts:check` compares the generated Zod against (blueprint 9, frozen).
CONTRACTS_DIR=<path to thehub-harness/contracts>

# --- runtime behaviour -------------------------------------------------------------------------------------------
# pino's level: `info` in production, `silent` under the unit project, `debug` when chasing something.
LOG_LEVEL=<trace|debug|info|warn|error|fatal|silent>
# The gateway's recording lane for the golden set: `off` calls the provider, `record` writes a cassette, `replay`
# reads one and calls nothing.
RECORD_MODE=<off|record|replay>
RECORD_DIR=<path to the recordings directory>

# --- the runners: golden set, demo export, end-to-end and the video ----------------------------------------------
# The base URL each runner drives. Left unset they use the local development server.
BASE_URL=<https://host of the deployment the golden runner drives>
EXPORT_BASE_URL=<https://host the demo export captures>
EXPORT_OUT=<path the demo export writes to>
PLAYWRIGHT_BASE_URL=<https://host the end-to-end suite drives>
PLAYWRIGHT_STATE_PATH=<path to the saved storage state>
VIDEO_BASE_URL=<https://host the video capture drives>
# The ceiling in milliseconds the golden setup step is allowed to spend before it gives up.
GOLDEN_SETUP_BUDGET_MS=<milliseconds>
