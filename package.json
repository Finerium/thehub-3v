{
  "name": "thehub-3v",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "gate:quick": "pnpm lint && pnpm typecheck && pnpm test:unit",
    "contracts:gen": "node scripts/contracts-check.mjs gen",
    "contracts:check": "node scripts/contracts-check.mjs check",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:seed:m0": "dotenv -e .env.local -- tsx scripts/db/seed-m0.ts",
    "db:check": "dotenv -e .env.local -- tsx scripts/db/check.ts",
    "smoke": "bash scripts/smoke.sh",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.1.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "json-schema-to-zod": "2.8.1",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.33.2"
}
