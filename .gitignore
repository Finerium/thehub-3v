# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output and caches
/.next/
/out/
/build
/dist
/coverage
.turbo/
*.tsbuildinfo
next-env.d.ts
.eslintcache

# environment and secrets: the example file is the only env file ever tracked
.env
.env.*
!.env.example
.vercel
.secrets/
CREDENTIALS_FOR_COMMITTEE*
*.pem

# tooling traces and process files (never committed to a public repository)
.claude/
.crown/
CLAUDE.local.md
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# corpus-derived text: extracted document text, chunks and page renders are never tracked publicly
bundle/chunks.jsonl
bundle/text/
seed/text/
seed/pages/
**/*.corpus-text.*

# test and capture artefacts
playwright-report/
test-results/
video/raw/
video/frames/
.env*
