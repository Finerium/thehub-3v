# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output and caches
/.next/
/out/
/build
/dist
/coverage
.turbo/
*.tsbuildinfo
next-env.d.ts
.eslintcache

# environment and secrets: the example file is the only env file ever tracked
.env
.env.*
!.env.example
.vercel
.secrets/
CREDENTIALS_FOR_COMMITTEE*
*.pem

# tooling traces and process files (never committed to a public repository)
.claude/
.crown/
CLAUDE.local.md
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# corpus-derived text: extracted document text, chunks and page renders are never tracked publicly
bundle/chunks.jsonl
bundle/text/
seed/text/
seed/pages/
**/*.corpus-text.*

# test and capture artefacts
playwright-report/
test-results/
video/raw/
video/frames/
.env*
# The last matching pattern wins, so the exception above has to be repeated after this block's wider rule, or the
# example file the blueprint 9.15 audit reads would be ignored (AC-NFR-22). It carries placeholders and no value.
!.env.example

# third-party agent skills auto-installed by integrations (trace policy)
.agents/
bundle/pages/
bundle/opls.json
/models/
# conflict copies produced by a sync client during parallel writes
* 2.*
graphify-out/

# The three deliverable artefacts are the organiser's corpus rendered for the Committee: the export carries runs of
# corpus text beyond citation length (measured: 1 file, tools/no_corpus_in_repo.py) and the video shows corpus pages,
# so they are never tracked in a public repository (INV-7, blueprint 8.3). deliverables/SHA256SUMS.txt IS tracked and
# is the record of what was handed over; every artefact rebuilds from this repository (D-25).
deliverables/*
!deliverables/SHA256SUMS.txt
